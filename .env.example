# ─── Session ───────────────────────────────────────────────────────────────────
# Secret used to sign session tokens (HMAC-SHA256).
# In demo mode this is optional — a fallback is used when not set.
SESSION_SECRET=change-me-to-a-random-32-char-string

# ─── Demo Credentials ──────────────────────────────────────────────────────────
# These are hardcoded in the demo — no database needed.
#
# Customer login  →  demo@fiestamania.com  /  demo1234
# Admin login     →  admin@fiestamania.com /  admin1234
# Admin panel     →  /admin/login  (user: admin, password: admin)

# ─── NOT needed in demo mode ───────────────────────────────────────────────────
# The following variables are used by the full production version only.
# Remove or leave blank for the public demo.
#
# DATABASE_URL=postgresql://user:password@localhost:5432/fiestamania
